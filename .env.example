# Copy to .env.local and fill in your PayPal sandbox app credentials
# (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# A sandbox PERSONAL account email (Testing Tools → Sandbox Accounts)
PAYPAL_BUYER_EMAIL=sb-xxxxxxxx@personal.example.com

# Anthropic API key — optional; without it the app uses built-in demo drafts
ANTHROPIC_API_KEY=

APP_BASE_URL=http://localhost:3000
